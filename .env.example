# ── Supabase (obrigatório já na Fase 1) ──────────────────────────────────────
# Painel do Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=chave-publica-anon
# NUNCA exponha no navegador. Usada só em jobs/webhooks no servidor.
SUPABASE_SERVICE_ROLE_KEY=chave-service-role

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Mercado Pago (Fase 3) ────────────────────────────────────────────────────
# Token da conta Agendaí (assinatura do SaaS). Tokens por negócio são salvos
# criptografados no banco, não aqui.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# ── Stripe alternativo (Fase 3, via camada PaymentProvider) ─────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Resend / e-mails (Fase 4) ────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Agendaí <lembretes@agendai.app>"

# ── Sentry (Fase 6) ──────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Jobs (Fases 3-4): segredo compartilhado pg_cron → Edge Functions ────────
CRON_SECRET=
